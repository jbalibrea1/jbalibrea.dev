---
import { ClientRouter } from 'astro:transitions';
import Footer from '@/components/Footer.astro';
import MainNavigation from '@/components/MainNavigation.astro';
import '@/styles/global.css';
import BackToTop from '@components/BackToTop.astro';

interface Props {
  title: string;
  description?: string;
  sticky?: boolean;
  image?: Image;
  canonicalURL?: string;
  postTitle?: boolean;
  /** Evita la indexación (p. ej. la 404) */
  noindex?: boolean;
  /** Metadatos de artículo para Open Graph */
  article?: { published: Date; modified?: Date; tags: string[] };
  /** Datos estructurados (schema.org) */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

interface Image {
  url: string;
  alt: string;
  /** Dimensiones reales de la imagen (por defecto, 1200x630) */
  width?: number;
  height?: number;
}

const descriptionDefault =
  'Jorge Balibrea — desarrollador Full Stack en Murcia. Especializado en React y Node.js. Explora mis proyectos y artículos sobre desarrollo web y tecnología.';
const imageDefault: Image = {
  url: '/og-default.jpg',
  alt: 'Foto de perfil de Jorge Balibrea',
};
const canonicalURLdefault = new URL(Astro.url.pathname, Astro.site);

const {
  title,
  description = descriptionDefault,
  sticky,
  image = imageDefault,
  canonicalURL = canonicalURLdefault,
  postTitle = false,
  noindex = false,
  article,
  jsonLd,
} = Astro.props;

const fullImageURL = `${import.meta.env.SITE}${image.url}`;
---

<!doctype html>
<html lang="es">
  <head>
    <!-- Google Tag Manager -->
    <script
      is:inline
      type="text/partytown"
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-3R2C9ZBRFV"
    ></script>
    <script is:inline type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        // gtag necesita el objeto `arguments` tal cual (no un array)
        // eslint-disable-next-line prefer-rest-params
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', 'G-3R2C9ZBRFV');
    </script>
    <!-- end Google Tag Manager -->

    <meta charset="utf-8" />
    <meta id="theme-color" name="theme-color" content="#ffffff" />

    <!-- Tema: se aplica antes del primer pintado para evitar el parpadeo -->
    <script is:inline>
      (function () {
        const COLORS = { light: '#ffffff', dark: '#09090b' };

        function getTheme() {
          let saved = null;
          try {
            saved = localStorage.getItem('theme');
          } catch {}
          if (saved === 'dark' || saved === 'light') return saved;
          return window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
        }

        function applyTheme(theme, doc) {
          doc.documentElement.classList.toggle('dark', theme === 'dark');
          const meta = doc.getElementById('theme-color');
          if (meta) meta.setAttribute('content', COLORS[theme]);
        }

        window.__theme = {
          get: getTheme,
          set: function (theme) {
            try {
              localStorage.setItem('theme', theme);
            } catch {}
            applyTheme(theme, document);
          },
        };

        applyTheme(getTheme(), document);
        // Con ClientRouter, aplicar el tema al documento nuevo antes del swap
        document.addEventListener('astro:before-swap', function (e) {
          applyTheme(getTheme(), e.newDocument);
        });
      })();
    </script>

    <!-- Meta tags -->
    <meta name="generator" content={Astro.generator} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Jorge Balibrea" />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} | jbalibrea.dev`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={postTitle ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="jbalibrea.dev" />
    <meta property="og:image" content={fullImageURL} />
    <meta property="og:image:width" content={String(image.width ?? 1200)} />
    <meta property="og:image:height" content={String(image.height ?? 630)} />
    <meta property="og:image:alt" content={image.alt} />
    {article && (
      <>
        <meta
          property="article:published_time"
          content={article.published.toISOString()}
        />
        {article.modified && (
          <meta
            property="article:modified_time"
            content={article.modified.toISOString()}
          />
        )}
        <meta property="article:author" content="Jorge Balibrea" />
        {article.tags.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}
    <!-- end Open Graph -->

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@jbalibrea1" />
    <meta name="twitter:creator" content="@jbalibrea1" />
    <meta name="twitter:title" content={`${title} | jbalibrea.dev`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageURL} />
    <meta name="twitter:image:alt" content={image.alt} />
    <meta name="twitter:url" content={canonicalURL} />
    <!-- end twitter -->

    <!-- Canonical URL  -->
    <link rel="canonical" href={canonicalURL} />

    {jsonLd && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
      />
    )}

    <!-- Local Fonts preloads  -->
    <link
      rel="preload"
      href="/fonts/satoshi/Satoshi-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="RSS Feed de jbalibrea - jbalibrea.dev"
      href={`${Astro.site}rss.xml`}
    />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link
      rel="icon"
      type="image/png"
      sizes="192x192"
      href="/android-chrome-192x192.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="512x512"
      href="/android-chrome-512x512.png"
    />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>
      {
        title === 'Home'
          ? 'Jorge Balibrea — Desarrollador Full Stack en Murcia'
          : `${title} | Jorge Balibrea — Desarrollador Full Stack`
      }
    </title>
    <slot name="head" />
    <ClientRouter />
  </head>

  <body class={Astro.url.pathname.startsWith('/blog') ? 'blog' : ''}>
    <a href="#main-content" class="skip-link">
      Saltar al contenido
    </a>
    <MainNavigation sticky={sticky} />
    <slot />
    <BackToTop />
    <Footer />
  </body>
</html>
