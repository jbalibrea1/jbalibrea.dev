---
import BlogNavigation from '@/components/BlogNavigation.astro';
import PostComment from '@/components/PostComment.tsx';
import Prose from '@/components/Prose.astro';
import type { InfoPost } from '@/interfaces/InfoPost';
import MediumZoom from '@components/MediumZoom.astro';
import ProgressBarBlog from '@components/ProgressBarBlog.astro';
import getSortedPosts from '@utils/getSortedPosts';
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

const { post, remarkPluginFrontmatter } = Astro.props;
const { title, description, image, pubDateTime, modDateTime, tags } = post.data;

// Vista previa (Open Graph): tarjeta 1200x630 generada en `src/pages/og/[slug].png.ts`.
// La portada del post (jpg optimizado) se usa solo en los datos estructurados.
const coverImage = await getImage({
  src: image.url,
  width: 1200,
  format: 'jpg',
});
const ogImageData = {
  url: `/og/${post.id}.png`,
  alt: title,
  width: 1200,
  height: 630,
};

const postUrl = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: [
    new URL(ogImageData.url, Astro.site).toString(),
    new URL(coverImage.src, Astro.site).toString(),
  ],
  datePublished: pubDateTime.toISOString(),
  dateModified: (modDateTime ?? pubDateTime).toISOString(),
  author: {
    '@type': 'Person',
    name: post.data.author,
    url: new URL('/', Astro.site).toString(),
  },
  mainEntityOfPage: postUrl,
  inLanguage: 'es',
  keywords: tags.join(', '),
};

/* ========== Prev/Next Posts ========== */
const posts = await getCollection('posts');
// posts ordenados por fecha
const sortedPosts = getSortedPosts(posts);
// info mínima para la navegación anterior/siguiente
const dataPosts = sortedPosts.map(({ data: { title }, slug }): InfoPost => ({
  slug,
  title,
}));

const currPostIdx = dataPosts.findIndex((a) => a.slug === post.id);

const prevPost =
  currPostIdx < dataPosts.length - 1 ? dataPosts[currPostIdx + 1] : null;

const nextPost = currPostIdx > 0 ? dataPosts[currPostIdx - 1] : null;
---

<BaseLayout
  title={`${title}`}
  description={`${description} - Por Jorge Balibrea · Desarrollador Full Stack en Murcia`}
  sticky={false}
  image={ogImageData}
  postTitle={true}
  article={{ published: pubDateTime, modified: modDateTime, tags }}
  jsonLd={jsonLd}
>
  <main id="main-content">
    <div class="flex gap-12 max-w-full">
      <div class="flex-1 min-w-0">
        <Prose
          post={post.data}
          minutesRead={remarkPluginFrontmatter.minutesRead}
        >
          <slot />
        </Prose>
      </div>

      <!-- side bar-->
      <aside
        class="fixed top-0 left-0 w-3/4 sm:w-2/3 md:w-2/4 lg:w-64 bg-bg-color-2 z-40 overflow-y-auto transform -translate-x-full transition-transform duration-300 lg:sticky lg:top-20 lg:translate-x-0 lg:block h-full lg:h-[calc(95vh-5rem)] lg:bg-transparent lg:shrink-0 py-4 px-2"
        id="sidebar"
      >
        <div class="sidebar-scroll h-full overflow-y-auto">
          <slot name="sidebar" />
        </div>
      </aside>
      <div
        id="sidebar-shade"
        class="fixed top-0 start-0 w-full h-full"
        style="display:none;background-color:#00000091;z-index:31"
      ></div>
      <!-- end side bar-->
    </div>
    <PostComment client:only="react" />
    <BlogNavigation prevPost={prevPost} nextPost={nextPost} />
    <button
      id="sidebar-btn"
      class="lg:hidden helpers fixed bottom-22"
      aria-label="Abrir tabla de contenidos"
      aria-controls="sidebar"
      aria-expanded="false"
    >
      ☰
    </button>
  </main>
  <MediumZoom />
  <ProgressBarBlog />
  <span
    id="copy-link-status"
    class="sr-only"
    role="status"
    aria-live="polite"
  ></span>
</BaseLayout>

<script>
  const OPEN_CLASS = '-translate-x-full';

  const els = () => ({
    sidebar: document.getElementById('sidebar'),
    btn: document.getElementById('sidebar-btn'),
    shade: document.getElementById('sidebar-shade'),
  });

  function setOpen(open: boolean) {
    const { sidebar, btn, shade } = els();
    if (!sidebar || !shade) return;
    sidebar.classList.toggle(OPEN_CLASS, !open);
    document.body.classList.toggle('no-scroll', open);
    shade.style.display = open ? 'block' : 'none';
    btn?.setAttribute('aria-expanded', String(open));
  }

  const isOpen = () => !els().sidebar?.classList.contains(OPEN_CLASS);

  // Este script se carga una sola vez; el sidebar es nuevo en cada navegación
  document.addEventListener('astro:page-load', () => {
    const { btn, shade } = els();
    btn?.addEventListener('click', () => setOpen(!isOpen()));
    shade?.addEventListener('click', () => setOpen(false));
    if (window.innerWidth >= 1024) setOpen(false);
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) setOpen(false);
  });
</script>
